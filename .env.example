# Copy to .env and fill in. Never commit .env.
#
# HOST and HTTP_PATH: SQL Warehouses -> your warehouse -> Connection details
# TOKEN:              Settings -> Developer -> Access tokens

DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123def456
DATABRICKS_TOKEN=<your-databricks-personal-access-token>

# Catalog and schema the agent audits.
TARGET_CATALOG=emissions
TARGET_SCHEMA=default

# LLM used for descriptions and PII classification.
# Free key at https://console.groq.com/keys
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
